<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_bg">

    <!-- ============ Main column ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/panel"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="menu"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu"
                android:tint="@color/text_main" />

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="CodeStudio"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="undo"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo"
                android:tint="@color/text_main" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="redo"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_redo"
                android:tint="@color/text_main" />

            <ImageButton
                android:id="@+id/btnSave"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="save"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_save"
                android:tint="@color/text_dim" />

            <ImageButton
                android:id="@+id/btnRun"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="run"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="@color/accent" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="more"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more"
                android:tint="@color/text_main" />
        </LinearLayout>

        <!-- Tabs row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@color/panel"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Editor WebView -->
        <WebView
            android:id="@+id/editorWeb"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Status bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:background="@color/panel"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFileType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="—"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Ln 1, Col 1"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Shortcut keys bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/panel"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/shortcutRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ============ Dim scrim ============ -->
    <View
        android:id="@+id/dimView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dim_scrim"
        android:visibility="gone" />

    <!-- ============ File Explorer drawer (left) ============ -->
    <FrameLayout
        android:id="@+id/drawerPanel"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:background="@color/panel"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/panel"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProjectName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:text="EXPLORER"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnNewFile"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="new file"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_file"
                    android:tint="@color/text_main" />

                <ImageButton
                    android:id="@+id/btnNewFolder"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="new folder"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add_folder"
                    android:tint="@color/text_main" />

                <ImageButton
                    android:id="@+id/btnSwitchProject"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="projects"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_projects"
                    android:tint="@color/text_main" />

                <ImageButton
                    android:id="@+id/btnRefreshTree"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="refresh"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/text_main" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/treeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="24dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- ============ Live Preview panel (bottom sheet) ============ -->
    <LinearLayout
        android:id="@+id/previewPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:background="@color/editor_bg"
        android:elevation="8dp"
        android:orientation="vertical">

        <!-- دستگیره: برای بستن، به پایین بکشید -->
        <View
            android:id="@+id/previewHandle"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="@drawable/preview_handle" />

        <LinearLayout
            android:id="@+id/previewHeader"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/panel"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="پیش‌نمایش زنده"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnBootstrap"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_toggle_bg"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:stateListAnimator="@null"
                android:text="Bootstrap 5"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnExpandPreview"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="toggle fullscreen preview"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_expand"
                android:tint="@color/text_main" />

            <ImageButton
                android:id="@+id/btnReloadPreview"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="reload preview"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh"
                android:tint="@color/text_main" />

            <ImageButton
                android:id="@+id/btnClosePreview"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="close preview"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                android:tint="#E0E0E0" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <WebView
            android:id="@+id/previewWeb"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
